# ============================================================
# Embedding 配置模板
#
# 用法：
#   1. 复制本文件为 .env.embedding（本文件名带 .example，不含真实 Key）
#   2. 把 EMBEDDING_API_KEY 换成真实 Key
#   3. 把这三行追加到 aistock-app-api/.env.production 末尾
#   4. 删除 .env.embedding（或者它已被 gitignore，不会被提交）
#
# ⚠ 不要把填了真实 Key 的版本提交到 git
# ============================================================

# 中转站地址。注意：这个值已经包含 /v1，
# 代码会自动判断，不会拼成 /v1/v1/embeddings。
EMBEDDING_BASE_URL=https://api.102465.xyz/v1

# 中转站 Key，形如 sk-xxxxx
EMBEDDING_API_KEY=

# 模型标识。我们选中文版，不是示例里的 en 版。
# 如果中转站要求带前缀（如 BAAI/bge-large-zh-v1.5），改成带前缀的写法。
# 填错会 404，日志里能看到确切报错。
EMBEDDING_MODEL=bge-large-zh-v1.5
