# ============================================================
# Embedding 配置模板
#
# 用法：
#   1. 复制本文件为 .env.embedding（本文件名带 .example，不含真实 Key）
#   2. 把 EMBEDDING_API_KEY 换成真实 Key
#   3. 把这三行追加到 aistock-app-api/.env.production 末尾
#   4. 删除 .env.embedding（或者它已被 gitignore，不会被提交）
#
# ⚠ 不要把填了真实 Key 的版本提交到 git
# ============================================================

# 中转站地址。注意：这个值已经包含 /v1，
# 代码会自动判断，不会拼成 /v1/v1/embeddings。
EMBEDDING_BASE_URL=https://api.102465.xyz/v1

# 中转站 Key，形如 sk-xxxxx
EMBEDDING_API_KEY=

# 模型标识。默认 bge-m3（1024 维，中文强）。
# 注意：图里看到的 bge-large-zh-v1.5 在 TokenHub 的 auto 分组下实际无可用渠道
# （2026-11-17 实测返回 503 model_not_found），不要填它。
# 模型名以 GET /v1/models 实际返回为准。填错会 404/503，日志里能看到确切报错。
EMBEDDING_MODEL=bge-m3
