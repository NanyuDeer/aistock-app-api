# ============================================
# AiStock App API — 环境变量模板
# 复制为 .env.development（本地开发）或 .env.production（服务器生产）
# .env.* 文件不提交 git，仅此模板提交
# ============================================

# 服务端口
PORT=3000
NODE_ENV=development

# 数据库
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/aistock
REDIS_URL=redis://:password@127.0.0.1:6379/9

# 安全
JWT_SECRET=your-jwt-secret
INTERNAL_API_TOKEN=your-internal-api-token

# 前端
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
CORS_ALLOW_ORIGIN=http://localhost:5173

# AI 模型（DeepSeek）
OPENAI_API_BASE_URL=https://api.deepseek.com/v1/chat/completions
OPENAI_API_KEY=sk-your-api-key
AI_BASE_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=sk-your-api-key
AI_MODEL=deepseek-v4-flash
EVA_MODEL=deepseek-v4-flash
OCR_MODEL=deepseek-v4-flash

CRAWLER_AI_BASE_URL=https://api.deepseek.com/v1
CRAWLER_AI_API_KEY=sk-your-api-key
CRAWLER_AI_MODEL=deepseek-v4-flash

# 短信验证码登录（生产短信服务商）
# 阿里云"号码认证·短信认证"（dypnsapi SendSmsVerifyCode，免企业签名/模板审核）：
#   - 用 RAM 用户 AccessKey + 号码认证工作台配置的"短信认证签名 + 预置模板"即可真实下发。
#   - 验证码由本项目本地生成并存 store 校验，阿里云作为发信通道下发到手机。
# dev 环境不真发，用固定测试码 123456（见 docs 设计文档 §9）。
# SMS_PROVIDER=aliyun      # aliyun | tencent；不设置则生产短信不可用（登录/绑定接口返回明确错误）
# SMS_ACCESS_KEY_ID=       # RAM 用户 AccessKey ID（号码认证权限）
# SMS_ACCESS_KEY_SECRET=   # RAM 用户 AccessKey Secret
# SMS_SIGN_NAME=           # 号码认证工作台"短信认证签名"（本系统：恒创联众）
# SMS_TEMPLATE_CODE=100001 # 登录/注册预置模板 code（号码认证工作台"登录/注册模板"）
# SMS_TEMPLATE_BIND=100004 # 绑定新手机号预置模板 code（号码认证工作台"绑定新手机号模板"）
# SMS_REGION=              # 可选，默认 aliyun:cn-hangzhou / tencent:ap-guangzhou

# 邮箱验证码登录（163 SMTP；个人邮箱 + 授权码即可，无需企业资质）
# 需在 163 邮箱设置开启 SMTP 服务并生成授权码（非登录密码）
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=your-email@163.com
EMAIL_SMTP_PASS=your-smtp-authcode
# EMAIL_FROM=your-email@163.com   # 可选，默认同 EMAIL_SMTP_USER

# 微信
WECHAT_APPID=your-appid
WECHAT_SECRET=your-secret
WECHAT_TOKEN=your-token
WECHAT_TEMPLATE_LEADER=template-id
WECHAT_TEMPLATE_OUTBREAK=template-id
WECHAT_TEMPLATE_ID=template-id

# 飞书
FEISHU_APP_ID=your-app-id
FEISHU_APP_SECRET=your-app-secret
FEISHU_ENTERPRISE_INVITE_LINK=https://example.feishu.cn/invite/xxx
FEISHU_ENTERPRISE_INVITE_QR_URL=/feishu-invite-qr.png

# 股票数据
TUSHARE_TOKEN=your-token

# 东方财富 ut 参数（D5 配置化；缺失各服务回退各自内置默认值）
# 东财轮换该参数时仅需更新此处，免发版刷新。
# 注意：须使用对 push2ex 涨停池也有效的 token（8dec03ba… 仅对 push2 clist 有效，对 push2ex 返回空，已实测），
# 否则涨停/炸板池会缺失；对默认 push2 主机被 TLS 风控的出口，依赖 EmSnapshotService 的 push2 → push2delay → push2his 主机轮询兜底。
EASTMONEY_UT=7eea3edcaed734bea9cbfc24409ed989

# Agent Python 服务
AGENT_PY_URL=http://localhost:8080

# TTS
TTS_PROVIDER=volcengine_podcast
VOLCENGINE_PODCAST_APP_ID=your-app-id
VOLCENGINE_PODCAST_ACCESS_TOKEN=your-access-token

# ===== 批次 3a：火山引擎流式 ASR（App 端语音输入） =====
# 控制台：https://console.volcengine.com/speech/service/10038?AppID=5551085502（需登录）
# 开通"流式语音识别"后可见：AppID / 应用令牌 Token / Cluster ID
VOLC_ASR_APPID=5551085502
VOLC_ASR_TOKEN=your-volc-asr-token
VOLC_ASR_CLUSTER=your-volc-cluster-id
